{
  "version": 1,
  "runtimes": {
    "claude": {"launch_argv": ["claude", "--model", "{model}"]},
    "codex": {"launch_argv": ["codex", "--model", "{model}"]},
    "gemini": {"launch_argv": ["gemini", "--model", "{model}"]},
    "cursor": {"launch_argv": []},
    "copilot": {"launch_argv": []},
    "generic": {"launch_argv": []}
  },
  "commands": {
    "test": ["{python}", "-m", "unittest", "discover", "-s", "tests", "-v"],
    "build": [],
    "smoke": ["{python}", ".harness/cli.py", "doctor"]
  },
  "budgets": {
    "command_timeout_seconds": 600,
    "session_timeout_seconds": 7200,
    "max_operations": 100,
    "max_plan_reviews": 2,
    "max_refinements": 3,
    "max_parallel_workers": 2
  },
  "models": {
    "policy": "best_available_subscription",
    "inventory_max_age_hours": 24,
    "commander_pin": null,
    "allow_api_billing": false
  },
  "review": {"required": true, "require_independent": false}
}
